# Anthropic API key used for the order-resolving ("what should this cart look like") calls.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta) - from your Meta Developer app / WhatsApp Business Account.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
# Any string you choose - set the same value in the Meta App Dashboard's webhook config.
META_WEBHOOK_VERIFY_TOKEN=
# Port for the public webhook server (GET/POST /webhook). Must be reachable over public
# HTTPS by Meta - see deploy/DEPLOY.md for exposing this via a domain+TLS or a tunnel.
META_WEBHOOK_PORT=8788

# Comma-separated WhatsApp numbers (E.164 without "+", e.g. "919804340701,919812345678")
# allow-listed to talk to the bot - the two flatmates. Also add these as allow-listed
# recipient test numbers in the Meta dashboard if you're on the free test-number tier.
WHATSAPP_ALLOWED_NUMBERS=

# Long random secret protecting the /admin/token endpoint used by `npm run swiggy-login`
# to push a freshly-obtained Swiggy access token to this process. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN_SECRET=

# Port for the small LOCAL-ONLY admin HTTP server (token push + health check). Bind to
# localhost and reach it over an SSH tunnel, or a firewall rule scoped to your own IP -
# this is separate from the public webhook port above and must never be exposed publicly.
ADMIN_PORT=8787

# Where the SQLite ledger/schedule/token DB lives.
DB_PATH=./data/bot.db
