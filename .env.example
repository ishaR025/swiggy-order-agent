# Anthropic API key used for the order-resolving ("what should this cart look like") calls.
ANTHROPIC_API_KEY=

# Filled in after running `npm run group-setup` and picking the right group from the printed list.
WHATSAPP_GROUP_JID=

# Long random secret protecting the /admin/token endpoint used by `npm run swiggy-login`
# to push a freshly-obtained Swiggy access token to this process. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN_SECRET=

# Port for the small local admin HTTP server (token push + health check). Keep this off the
# public internet - bind to localhost and reach it over an SSH tunnel, or put it behind a
# firewall rule that only allows your own IP.
ADMIN_PORT=8787

# Where the SQLite ledger/schedule/token DB lives.
DB_PATH=./data/bot.db

# Where Baileys persists WhatsApp auth state (multi-file credential store).
WHATSAPP_AUTH_DIR=./auth
